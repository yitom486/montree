{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/desktop/src/*"],
      "@foliate/*": ["./third-party/foliate-js/*"],
      "@inkdown/contracts": ["./packages/contracts/src/index.ts"],
      "@inkdown/reader-core": ["./packages/reader-core/src/index.ts"],
      "@inkdown/pdf": ["./packages/pdf/src/index.ts"],
      "@inkdown/ocr-core": ["./packages/ocr-core/src/index.ts"],
      "@inkdown/annotations": ["./packages/annotations/src/index.ts"],
      "@inkdown/web-doc": ["./packages/web-doc/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["apps/desktop/src/**/*", "packages/contracts/src/**/*", "packages/reader-core/src/**/*", "packages/pdf/src/**/*", "packages/ocr-core/src/**/*", "packages/annotations/src/**/*", "packages/web-doc/src/**/*"]
}
