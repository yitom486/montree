{
  "name": "montree",
  "version": "0.4.19",
  "description": "Montree — Markdown 编辑、电子书与在线文档阅读、Agent 助手",
  "author": "Yitom <yitom486@gmail.com>",
  "license": "GPL-3.0-only",
  "main": "out/main/main.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@firecrawl/pdf-inspector": "https://github.com/yitom486/pdf-inspector/releases/download/inkdown-napi-v1.18.0/firecrawl-pdf-inspector-1.18.0.tgz",
    "@yitom/chat": "0.1.26",
    "@yitom/contracts": "0.1.26",
    "@yitom/reader-core": "0.1.26",
    "@yitom/annotations": "0.1.26",
    "@yitom/chat-core": "0.1.26",
    "@yitom/chat-ui": "0.1.26",
    "@yitom/chat-session": "0.1.26",
    "@agentclientprotocol/sdk": "1.9.0",
    "@firecrawl/pdf-inspector-win32-x64-msvc": "https://github.com/yitom486/pdf-inspector/releases/download/inkdown-napi-v1.18.0/firecrawl-pdf-inspector-win32-x64-msvc-1.18.0.tgz",
    "@firecrawl/pdf-inspector-darwin-arm64": "https://github.com/yitom486/pdf-inspector/releases/download/inkdown-napi-v1.18.0/firecrawl-pdf-inspector-darwin-arm64-1.18.0.tgz",
    "@firecrawl/pdf-inspector-linux-x64-gnu": "https://github.com/yitom486/pdf-inspector/releases/download/inkdown-napi-v1.18.0/firecrawl-pdf-inspector-linux-x64-gnu-1.18.0.tgz",
    "@yitom/acp-client": "latest"
  },
  "scripts": {
    "dev": "electron-vite dev --config apps/desktop/electron.vite.config.ts",
    "build": "electron-vite build --config apps/desktop/electron.vite.config.ts",
    "preview": "electron-vite preview --config apps/desktop/electron.vite.config.ts",
    "pack": "bun run prepare:typst && bun run build:remote-server && bun run build && electron-builder --config apps/desktop/electron-builder.yml --publish never",
    "pack:win": "bun run prepare:typst && bun run build:remote-server && bun run build && electron-builder --config apps/desktop/electron-builder.yml --win --publish never",
    "pack:mac": "bun run prepare:typst && bun run build:remote-server && bun run build && electron-builder --config apps/desktop/electron-builder.yml --mac --publish never",
    "pack:linux": "bun run prepare:typst && bun run build:remote-server && bun run build && electron-builder --config apps/desktop/electron-builder.yml --linux --publish never",
    "prepare:typst": "bun run scripts/prepare-typst.ts",
    "icons": "bun run scripts/generate-icon.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --config apps/desktop/playwright.config.ts",
    "test:e2e:web-doc": "playwright test --config apps/desktop/playwright.config.ts apps/desktop/e2e/web-doc-smoke.spec.ts",
    "test:all": "bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "doctor": "bun run scripts/doctor.ts",
    "lint:docs": "bun run scripts/lint-docs.ts",
    "lint:deps": "bun run scripts/check-deps.ts",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "build:remote-server": "bun run packages/remote-server/scripts/build.ts",
    "release": "bun run scripts/release.ts",
    "release:push": "bun run scripts/release.ts -- --push",
    "postinstall": "bun node_modules/electron/install.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@assistant-ui/react": "^0.15.27",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@firecrawl/pdf-inspector": "^1.18.0",
    "@firecrawl/pdf-inspector-wasm": "^1.18.0",
    "@google/genai": "2.27.0",
    "@lezer/common": "^1.5.2",
    "@lezer/html": "^1.3.13",
    "@mdit/plugin-alert": "^2.0.2",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tanstack/react-query": "^5.102.8",
    "@univerjs/preset-sheets-core": "^1.0.3",
    "@univerjs/presets": "^1.0.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@yitom/acp-client": "latest",
    "@yitom/chat": "0.1.26",
    "ai": "^7.0.137",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "0.6.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "fast-diff": "^1.3.0",
    "fflate": "^0.8.3",
    "gemini-tts-studio": "^0.3.3",
    "hast-util-sanitize": "^5.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "sucrase": "^3.35.1",
    "vanilla-jsoneditor": "^3.13.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.13",
    "lucide-react": "^1.35.0",
    "png-to-ico": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
